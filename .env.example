# ============================================================================
# REVIVE — SUBSCRIPTION MANAGEMENT & REVENUE INTELLIGENCE PLATFORM
# Copy this file to .env and configure credentials for production services.
# Without external keys, Revive automatically runs with its persistent
# local database and explicit Demo Mode indicators.
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-secure-random-64-char-secret-in-production

# Supabase Configuration (Database & Authentication)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# WARNING: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser / VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# OpenAI Configuration (Server-Side Only for AI Revenue Copilot)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Razorpay Configuration (Test Mode for Checkout & Subscriptions)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
# WARNING: Never expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in frontend code
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Email Delivery (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=billing@yourdomain.com

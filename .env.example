# ============================================================================
# REVIVE — SUBSCRIPTION MANAGEMENT & REVENUE INTELLIGENCE PLATFORM
# Copy this file to .env and configure your Supabase and Google Gemini keys.
# ============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-secure-random-64-char-secret-in-production

# Supabase Configuration (Database & Authentication)
# Use the publishable/anon key for frontend and service-role secret key on backend only
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
# WARNING: Never expose SUPABASE_SERVICE_ROLE_KEY to the browser / VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Google Gemini Configuration (Server-Side Only for AI Revenue Copilot)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
